@page "/"
@namespace BlazorApp.Pages
@using Microsoft.AspNetCore.Components.Web
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>QueueLess CIT-U</title>
    <base href="~/" />

    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        'cit-maroon': '#7b1120',
                        'cit-maroon-dark': '#580a15',
                        'cit-gold': '#c98007',
                        'cit-gold-hover': '#b06f04',
                    }
                }
            }
        }
    </script>

    <!-- Audio Chime & Speech API -->
    <script>
        window.queueAudio = {
            playChimeAndSpeak: function (text) {
                try {
                    const ctx = new (window.AudioContext || window.webkitAudioContext)();
                    const osc = ctx.createOscillator();
                    const gain = ctx.createGain();
                    osc.connect(gain);
                    gain.connect(ctx.destination);
                    osc.frequency.setValueAtTime(587.33, ctx.currentTime);
                    osc.frequency.setValueAtTime(880.00, ctx.currentTime + 0.15);
                    gain.gain.setValueAtTime(0.2, ctx.currentTime);
                    gain.gain.exponentialRampToValueAtTime(0.0001, ctx.currentTime + 0.6);
                    osc.start(ctx.currentTime);
                    osc.stop(ctx.currentTime + 0.6);
                } catch (e) { }

                if ('speechSynthesis' in window && text) {
                    setTimeout(() => {
                        window.speechSynthesis.cancel();
                        const utterance = new SpeechSynthesisUtterance(text);
                        utterance.rate = 0.95;
                        utterance.pitch = 1.05;
                        window.speechSynthesis.speak(utterance);
                    }, 400);
                }
            }
        };
    </script>

    <style>
        .nav-btn.active {
            background-color: rgba(255, 255, 255, 0.28) !important;
        }
        #blazor-error-ui {
            display: none !important;
        }
    </style>

    <component type="typeof(Microsoft.AspNetCore.Components.Web.HeadOutlet)" render-mode="ServerPrerendered" />
</head>
<body class="bg-gray-50 text-gray-900 m-0">
    <component type="typeof(App)" render-mode="ServerPrerendered" />
    <div id="blazor-error-ui">
        An unhandled exception has occurred. <a href="" class="reload">Reload</a>
    </div>
    <script src="_framework/blazor.server.js"></script>
</body>
</html>