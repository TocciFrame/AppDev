@page "/"
@namespace BlazorApp.Pages
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>QueueLess CIT-U</title>
    <base href="~/" />

    <script src="https://cdn.tailwindcss.com"></script>

    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        'cit-maroon': '#7b1120',
                        'cit-maroon-dark': '#580a15',
                        'cit-gold': '#c98007',
                        'cit-gold-hover': '#b06f04',
                    }
                }
            }
        }
    </script>

    <style>
        .nav-btn.active {
            background-color: rgba(255, 255, 255, 0.28) !important;
        }
        #blazor-error-ui {
            display: none !important;
        }
    </style>

    <component type="typeof(Microsoft.AspNetCore.Components.Web.HeadOutlet)" render-mode="ServerPrerendered" />
</head>
<body class="bg-gray-50 text-gray-900 m-0">
    <component type="typeof(App)" render-mode="ServerPrerendered" />

    <div id="blazor-error-ui">
        An unhandled exception has occurred. <a href="" class="reload">Reload</a>
    </div>

    <script src="_framework/blazor.server.js"></script>
</body>
</html>