@page "/track/{TicketNumber}"
@inject QueueService QueueService
@implements IDisposable

<div class="max-w-md mx-auto my-8 px-4">
    @if (ticket != null)
    {
        @if (ticket.Status == TicketStatus.NowServing)
        {
            <div class="bg-emerald-50 border-2 border-emerald-500 rounded-3xl p-8 text-center shadow-2xl animate-pulse">
                <span class="inline-block bg-emerald-600 text-white font-black text-xs uppercase px-4 py-1 rounded-full mb-3 tracking-widest">
                    🔔 IT'S YOUR TURN NOW!
                </span>
                <h2 class="text-6xl font-black text-emerald-700 tracking-tight my-2">@ticket.TicketNumber</h2>
                <p class="text-sm font-bold text-gray-700 mb-6">@ticket.Department</p>

                <div class="bg-white rounded-2xl p-6 shadow-inner border border-emerald-200 mb-6">
                    <span class="block text-xs uppercase font-bold text-gray-400 mb-1">PROCEED IMMEDIATELY TO</span>
                    <strong class="text-3xl font-black text-gray-900 block text-emerald-600">
                        @(string.IsNullOrEmpty(ticket.Teller) ? "Counter 1" : ticket.Teller)
                    </strong>
                </div>

                <div class="text-xs text-gray-600">
                    Serving: <strong>@ticket.StudentName</strong><br />
                    Transaction: @ticket.Service
                </div>
            </div>
        }
        else if (ticket.Status == TicketStatus.Waiting)
        {
            <div class="bg-white rounded-3xl p-6 sm:p-8 shadow-xl border border-gray-100 text-center">
                <div class="flex justify-between items-center mb-4">
                    <span class="text-xs font-bold text-gray-400 uppercase tracking-wider">Queue Tracking</span>
                    @if (ticket.IsPriority)
                    {
                        <span class="bg-amber-100 text-amber-900 text-xs font-black px-2.5 py-0.5 rounded-full">⚡ PRIORITY</span>
                    }
                </div>

                <h2 class="text-5xl font-black text-cit-maroon tracking-wider my-1">@ticket.TicketNumber</h2>
                <span class="text-sm font-bold text-cit-gold block mb-6">@ticket.Department</span>

                <div class="bg-amber-50/60 border border-amber-200 rounded-2xl p-6 mb-6">
                    <span class="text-xs font-bold text-gray-400 uppercase tracking-wider block mb-1">AHEAD OF YOU</span>
                    <div class="text-5xl font-black text-gray-900 my-1">@AheadCount</div>
                    <span class="text-xs text-gray-500 font-medium">students in line before your turn</span>

                    <div class="mt-4 pt-4 border-t border-amber-200/60 flex justify-between text-xs font-semibold text-gray-600">
                        <span>Estimated Wait:</span>
                        <strong class="text-cit-maroon">~@(AheadCount * 4 + 2) mins</strong>
                    </div>
                </div>

                <div class="bg-gray-50 rounded-xl p-4 text-left text-xs space-y-2 mb-6 text-gray-600">
                    <div class="flex justify-between"><span>Student:</span> <strong class="text-gray-900">@ticket.StudentName</strong></div>
                    <div class="flex justify-between"><span>Service:</span> <strong class="text-gray-900">@ticket.Service</strong></div>
                    <div class="flex justify-between"><span>Queue Time:</span> <strong class="text-gray-900">@ticket.CreatedAt.ToString("h:mm tt")</strong></div>
                </div>

                <p class="text-xs text-gray-400">Feel free to grab food or study. This page updates live!</p>
            </div>
        }
        else
        {
            <div class="bg-white rounded-3xl p-8 shadow-lg border border-gray-200 text-center">
                <div class="text-5xl mb-3">✔</div>
                <h3 class="text-2xl font-black text-gray-900 mb-1">Ticket @ticket.Status</h3>
                <p class="text-xs text-gray-500 mb-6">Your transaction has finished.</p>
                <a href="student" class="inline-block bg-cit-gold text-white text-xs font-bold px-6 py-3 rounded-xl shadow">
                    Get a New Ticket
                </a>
            </div>
        }
    }
    else
    {
        <div class="bg-white rounded-2xl p-8 shadow text-center border">
            <h3 class="font-bold text-gray-800">Ticket Not Found</h3>
            <p class="text-xs text-gray-500 mt-1 mb-4">No active ticket matches "@TicketNumber".</p>
            <a href="student" class="text-cit-maroon font-bold text-xs underline">Back to Student Kiosk</a>
        </div>
    }
</div>

@code {
    [Parameter] public string TicketNumber { get; set; } = "";

    private QueueTicket? ticket => 
        QueueService.Tickets.FirstOrDefault(t => t.TicketNumber == TicketNumber) 
        ?? QueueService.History.FirstOrDefault(t => t.TicketNumber == TicketNumber);

    private int AheadCount =>
        ticket == null ? 0 :
        QueueService.Tickets.Count(t => t.Department == ticket.Department 
                                     && t.Status == TicketStatus.Waiting 
                                     && (ticket.IsPriority ? (t.IsPriority && t.CreatedAt < ticket.CreatedAt) 
                                                           : (t.IsPriority || t.CreatedAt < ticket.CreatedAt)));

    private bool _isDisposed = false;

    protected override void OnInitialized()
    {
        QueueService.OnChange += OnStateChanged;
    }

    private void OnStateChanged()
    {
        _ = InvokeAsync(() =>
        {
            if (!_isDisposed) StateHasChanged();
        });
    }

    public void Dispose()
    {
        _isDisposed = true;
        QueueService.OnChange -= OnStateChanged;
    }
}