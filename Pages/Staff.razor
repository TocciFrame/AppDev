@page "/staff"
@inject QueueService QueueService
@implements IDisposable

<div class="max-w-7xl mx-auto my-8 px-4 sm:px-6">
    <!-- Header Controls -->
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-8">
        <div class="flex items-center gap-3">
            <span class="text-3xl">🎧</span>
            <div>
                <h2 class="text-2xl font-black text-gray-900 tracking-tight">Staff Queue Management</h2>
                <p class="text-sm text-gray-500">Manage and serve student tickets in real-time.</p>
            </div>
        </div>

        <div class="flex items-center gap-3 flex-wrap">
            <label class="text-xs font-bold uppercase text-gray-500">Filter Department:</label>
            <select class="px-3 py-1.5 text-sm rounded-lg border border-gray-300 bg-white font-medium focus:ring-2 focus:ring-cit-gold outline-none" @bind="selectedDept">
                <option value="All">All Departments</option>
                <option value="Registrar Office">Registrar Office</option>
                <option value="Finance and Accounting Office">Finance Office</option>
                <option value="Enrollment Technical Office">Enrollment Technical Office</option>
            </select>
            <button class="px-3 py-1.5 text-xs font-bold rounded-lg border border-gray-300 bg-white hover:bg-gray-50 text-gray-700 transition" @onclick="QueueService.SeedInitialData">
                ↻ Reset Demo Data
            </button>
        </div>
    </div>

    <!-- Metrics Row -->
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 mb-8">
        <div class="bg-white border border-gray-200/80 rounded-2xl p-5 shadow-sm flex items-center justify-between">
            <div>
                <span class="block text-xs font-bold text-gray-400 uppercase tracking-wider">Waiting</span>
                <span class="text-3xl font-black text-gray-900 mt-1">@WaitingCount</span>
            </div>
            <span class="text-3xl text-orange-500 bg-orange-50 p-2.5 rounded-xl">👥</span>
        </div>

        <div class="bg-white border border-gray-200/80 rounded-2xl p-5 shadow-sm flex items-center justify-between">
            <div>
                <span class="block text-xs font-bold text-gray-400 uppercase tracking-wider">Now Serving</span>
                <span class="text-3xl font-black text-gray-900 mt-1">@ServingCount</span>
            </div>
            <span class="text-3xl text-amber-500 bg-amber-50 p-2.5 rounded-xl">🔔</span>
        </div>

        <div class="bg-white border border-gray-200/80 rounded-2xl p-5 shadow-sm flex items-center justify-between">
            <div>
                <span class="block text-xs font-bold text-gray-400 uppercase tracking-wider">Completed</span>
                <span class="text-3xl font-black text-gray-900 mt-1">@CompletedCount</span>
            </div>
            <span class="text-3xl text-emerald-500 bg-emerald-50 p-2.5 rounded-xl">✔</span>
        </div>

        <div class="bg-white border border-gray-200/80 rounded-2xl p-5 shadow-sm flex items-center justify-between">
            <div>
                <span class="block text-xs font-bold text-gray-400 uppercase tracking-wider">Skipped</span>
                <span class="text-3xl font-black text-gray-900 mt-1">@SkippedCount</span>
            </div>
            <span class="text-3xl text-blue-500 bg-blue-50 p-2.5 rounded-xl">⏭</span>
        </div>
    </div>

    <!-- Workspace (2 Columns) -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
        <!-- Currently Serving -->
        <div class="lg:col-span-6">
            <h4 class="text-xs font-bold text-gray-400 uppercase tracking-wider mb-3">CURRENTLY SERVING</h4>

            @if (CurrentServing != null)
            {
                <div class="bg-white border border-gray-200 rounded-2xl p-6 shadow-sm">
                    <div class="flex justify-between items-start mb-6">
                        <div>
                            <h3 class="text-4xl font-black text-cit-maroon tracking-tight">@CurrentServing.TicketNumber</h3>
                            <span class="text-xs font-medium text-gray-500">@CurrentServing.Department</span>
                        </div>
                        <span class="bg-emerald-50 text-emerald-700 border border-emerald-200 text-xs font-bold px-3 py-1 rounded-full uppercase tracking-wider">
                            Active Session
                        </span>
                    </div>

                    <div class="grid grid-cols-2 gap-4 bg-gray-50 p-4 rounded-xl text-sm mb-6">
                        <div>
                            <span class="block text-xs text-gray-400">Student Name</span>
                            <strong class="text-gray-900">@CurrentServing.StudentName</strong>
                        </div>
                        <div>
                            <span class="block text-xs text-gray-400">Student ID</span>
                            <strong class="text-gray-900">@CurrentServing.StudentId</strong>
                        </div>
                        <div>
                            <span class="block text-xs text-gray-400">Service</span>
                            <strong class="text-gray-900">@CurrentServing.Service</strong>
                        </div>
                        <div>
                            <span class="block text-xs text-gray-400">Counter / Teller</span>
                            <strong class="text-gray-900">@(string.IsNullOrEmpty(CurrentServing.Teller) ? "Counter 1" : CurrentServing.Teller)</strong>
                        </div>
                    </div>

                    <div class="flex gap-3">
                        <button class="flex-1 bg-emerald-600 hover:bg-emerald-700 text-white font-bold py-3 rounded-xl shadow transition" @onclick="() => QueueService.CompleteServingTicket(CurrentServing.TicketNumber)">
                            ✔ Mark Complete
                        </button>
                        <button class="bg-rose-50 hover:bg-rose-100 text-rose-700 border border-rose-200 font-bold px-5 py-3 rounded-xl transition" @onclick="() => QueueService.SkipTicket(CurrentServing.TicketNumber)">
                            ⏭ Skip
                        </button>
                    </div>
                </div>
            }
            else
            {
                <div class="bg-white border border-gray-200 rounded-2xl p-10 text-center shadow-sm">
                    <div class="text-4xl mb-2">☕</div>
                    <h4 class="text-base font-bold text-gray-800">No Student At Counter</h4>
                    <p class="text-xs text-gray-500 max-w-sm mx-auto mt-1 mb-4">Select a student from the waiting list or call next ticket in line.</p>
                    @if (WaitingCount > 0)
                    {
                        var targetDept = selectedDept == "All" ? "Registrar Office" : selectedDept;
                        <button class="bg-cit-gold hover:bg-cit-gold-hover text-white font-bold px-5 py-2.5 rounded-xl text-sm shadow transition" @onclick='() => QueueService.CallNext(targetDept, "Window 1")'>
                            📢 Call Next (@targetDept)
                        </button>
                    }
                </div>
            }
        </div>

        <!-- Waiting Line -->
        <div class="lg:col-span-6">
            <h4 class="text-xs font-bold text-gray-400 uppercase tracking-wider mb-3 flex items-center justify-between">
                <span>UPCOMING IN LINE</span>
                <span class="bg-gray-200 text-gray-700 text-[0.7rem] px-2 py-0.5 rounded-full font-bold">@FilteredWaitingTickets.Count</span>
            </h4>

            <div class="space-y-3">
                @if (FilteredWaitingTickets.Any())
                {
                    @foreach (var ticket in FilteredWaitingTickets)
                    {
                        <div class="bg-white border border-gray-200/80 rounded-xl p-4 shadow-sm flex items-center justify-between gap-4">
                            <div class="min-w-[90px]">
                                <span class="font-extrabold text-base text-cit-maroon block leading-tight">@ticket.TicketNumber</span>
                                <span class="text-xs text-gray-400">@ticket.CreatedAt.ToString("h:mm tt")</span>
                            </div>
                            <div class="flex-1 min-w-0">
                                <strong class="block text-sm text-gray-800 truncate">@ticket.StudentName</strong>
                                <span class="block text-xs text-gray-500 truncate">@ticket.Service • @ticket.Department</span>
                            </div>
                            <button class="px-3.5 py-1.5 rounded-lg border border-gray-300 text-gray-700 hover:bg-gray-100 text-xs font-bold transition whitespace-nowrap" @onclick='() => QueueService.CallNext(ticket.Department, "Counter 1")'>
                                Call Now
                            </button>
                        </div>
                    }
                }
                else
                {
                    <div class="bg-white border border-dashed border-gray-300 rounded-xl p-8 text-center text-xs text-gray-400">
                        No students currently waiting. New tickets generated at <span class="font-bold text-gray-600">/student</span> will appear here instantly.
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@code {
    private string selectedDept = "All";
    private bool _isDisposed = false;

    private IEnumerable<QueueTicket> ActiveTickets =>
        selectedDept == "All" 
            ? QueueService.Tickets 
            : QueueService.Tickets.Where(t => t.Department == selectedDept);

    private QueueTicket? CurrentServing => ActiveTickets.FirstOrDefault(t => t.Status == TicketStatus.NowServing);
    private List<QueueTicket> FilteredWaitingTickets => ActiveTickets.Where(t => t.Status == TicketStatus.Waiting).ToList();

    private int WaitingCount => QueueService.Tickets.Count(t => t.Status == TicketStatus.Waiting);
    private int ServingCount => QueueService.Tickets.Count(t => t.Status == TicketStatus.NowServing);
    private int CompletedCount => QueueService.History.Count(t => t.Status == TicketStatus.Completed);
    private int SkippedCount => QueueService.History.Count(t => t.Status == TicketStatus.Skipped);

    protected override void OnInitialized()
    {
        QueueService.OnChange += OnQueueUpdated;
    }

    private void OnQueueUpdated()
    {
        _ = InvokeAsync(() =>
        {
            if (!_isDisposed)
            {
                StateHasChanged();
            }
        });
    }

    public void Dispose()
    {
        _isDisposed = true;
        QueueService.OnChange -= OnQueueUpdated;
    }
}