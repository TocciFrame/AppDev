@page "/student"
@inject QueueService QueueService

<div class="max-w-xl mx-auto my-8 sm:my-12 px-4">
    <div class="bg-white rounded-2xl p-6 sm:p-8 shadow-xl border border-gray-100">
        @if (generatedTicket == null)
        {
            <div class="text-center mb-6">
                <span class="inline-block bg-amber-100 text-amber-900 font-bold text-xs uppercase tracking-wider px-3 py-1 rounded-full mb-2">
                    CIT-U Student Kiosk
                </span>
                <h2 class="text-2xl sm:text-3xl font-extrabold text-gray-900">Get Your Queue Ticket</h2>
                <p class="text-sm text-gray-500 mt-1">Select your office and transaction to reserve your spot.</p>
            </div>

            <EditForm Model="formModel" OnValidSubmit="HandleSubmit" class="space-y-4">
                <div>
                    <label class="block text-xs font-bold text-gray-700 uppercase tracking-wider mb-1">Full Name</label>
                    <input type="text" class="w-full px-4 py-2.5 rounded-lg border border-gray-300 focus:ring-2 focus:ring-cit-gold focus:border-cit-gold outline-none transition" required placeholder="e.g. Lemuel Vincent V. Alcoseba III" @bind="formModel.Name" />
                </div>

                <div>
                    <label class="block text-xs font-bold text-gray-700 uppercase tracking-wider mb-1">Student ID Number</label>
                    <input type="text" class="w-full px-4 py-2.5 rounded-lg border border-gray-300 focus:ring-2 focus:ring-cit-gold focus:border-cit-gold outline-none transition" required placeholder="e.g. 21-1234-567" @bind="formModel.StudentId" />
                </div>

                <div>
                    <label class="block text-xs font-bold text-gray-700 uppercase tracking-wider mb-1">Department / Office</label>
                    <select class="w-full px-4 py-2.5 rounded-lg border border-gray-300 focus:ring-2 focus:ring-cit-gold focus:border-cit-gold outline-none bg-white transition" @onchange="OnDepartmentChanged">
                        @foreach (var dept in Departments)
                        {
                            <option value="@dept">@dept</option>
                        }
                    </select>
                </div>

                <div>
                    <label class="block text-xs font-bold text-gray-700 uppercase tracking-wider mb-1">Transaction / Purpose</label>
                    <select class="w-full px-4 py-2.5 rounded-lg border border-gray-300 focus:ring-2 focus:ring-cit-gold focus:border-cit-gold outline-none bg-white transition" @bind="formModel.Service">
                        @foreach (var s in AvailableServices)
                        {
                            <option value="@s">@s</option>
                        }
                    </select>
                </div>

                <!-- Priority Lane Checkbox -->
                <div class="bg-amber-50 border border-amber-200 rounded-xl p-3.5 flex items-start gap-3">
                    <input type="checkbox" id="priorityCheck" class="mt-1 h-4 w-4 text-cit-maroon rounded focus:ring-cit-gold cursor-pointer" @bind="formModel.IsPriority" />
                    <label for="priorityCheck" class="text-xs text-gray-700 select-none cursor-pointer">
                        <strong class="text-amber-900 block">⚡ Request Priority Lane</strong>
                        For PWD, Senior Citizens, Pregnant Students, or Express Clearance.
                    </label>
                </div>

                <button type="submit" class="w-full bg-cit-gold hover:bg-cit-gold-hover text-white py-3.5 rounded-xl font-bold text-base shadow-lg transition-all duration-150 transform hover:-translate-y-0.5 mt-2">
                    Generate Ticket ➔
                </button>
            </EditForm>
        }
        else
        {
            <!-- Ticket Receipt -->
            <div class="border-2 border-dashed border-cit-gold/70 rounded-2xl p-6 sm:p-8 bg-amber-50/40 text-center relative overflow-hidden">
                <div class="text-[0.65rem] font-bold text-cit-maroon uppercase tracking-wider mb-1">
                    Cebu Institute of Technology - University
                </div>
                <h3 class="text-base font-extrabold text-gray-800 uppercase tracking-wide mb-3">Electronic Queue Pass</h3>

                <div class="text-5xl sm:text-6xl font-black text-cit-maroon tracking-wider my-2">
                    @generatedTicket.TicketNumber
                </div>

                <div class="text-sm font-bold text-cit-gold mb-6">
                    @generatedTicket.Department
                </div>

                <div class="bg-white border border-amber-200 rounded-xl p-4 text-left text-xs sm:text-sm divide-y divide-amber-100 shadow-sm mb-6">
                    <div class="flex justify-between py-2">
                        <span class="text-gray-500">Student:</span>
                        <strong class="text-gray-900">@generatedTicket.StudentName</strong>
                    </div>
                    <div class="flex justify-between py-2">
                        <span class="text-gray-500">ID No:</span>
                        <strong class="text-gray-900">@generatedTicket.StudentId</strong>
                    </div>
                    <div class="flex justify-between py-2">
                        <span class="text-gray-500">Service:</span>
                        <strong class="text-gray-900">@generatedTicket.Service</strong>
                    </div>
                    <div class="flex justify-between py-2">
                        <span class="text-gray-500">Lane Type:</span>
                        <strong class="@(generatedTicket.IsPriority ? "text-amber-600 font-black" : "text-gray-900")">
                            @(generatedTicket.IsPriority ? "⚡ Priority Lane" : "Regular Lane")
                        </strong>
                    </div>
                    <div class="flex justify-between py-2">
                        <span class="text-gray-500">Issued At:</span>
                        <strong class="text-gray-900">@generatedTicket.CreatedAt.ToString("h:mm tt")</strong>
                    </div>
                </div>

                <!-- Direct Tracking Button & Action -->
                <div class="space-y-2">
                    <a href="track/@generatedTicket.TicketNumber" target="_blank" class="w-full inline-flex items-center justify-center gap-2 bg-cit-maroon hover:bg-cit-maroon-dark text-white py-3 rounded-xl text-sm font-bold shadow transition">
                        📱 Track Ticket Live on Phone ➔
                    </a>
                    <button class="w-full bg-white hover:bg-gray-100 text-gray-700 border border-gray-300 py-2.5 rounded-xl text-xs font-semibold transition" @onclick="() => generatedTicket = null">
                        + Issue Another Ticket
                    </button>
                </div>
            </div>
        }
    </div>
</div>

@code {
    private FormModel formModel = new();
    private QueueTicket? generatedTicket;

    private readonly List<string> Departments = new()
    {
        "Registrar Office",
        "Finance and Accounting Office",
        "Enrollment Technical Office"
    };

    private List<string> AvailableServices = new();

    protected override void OnInitialized()
    {
        formModel.Department = Departments[0];
        UpdateServices();
    }

    private void OnDepartmentChanged(ChangeEventArgs e)
    {
        formModel.Department = e.Value?.ToString() ?? Departments[0];
        UpdateServices();
    }

    private void UpdateServices()
    {
        AvailableServices = formModel.Department switch
        {
            "Registrar Office" => new List<string> { "Clearance Signing", "Transcript of Records", "Enrollment Validation", "Diploma Request" },
            "Finance and Accounting Office" => new List<string> { "Tuition Payment", "Promissory Note", "Refund Request", "Exam Permit" },
            _ => new List<string> { "Change of Subject", "Adding/Dropping", "Overload Form Approval" }
        };
        formModel.Service = AvailableServices.FirstOrDefault() ?? "";
    }

    private void HandleSubmit()
    {
        generatedTicket = QueueService.CreateTicket(
            formModel.Department,
            formModel.Service,
            formModel.Name,
            formModel.StudentId,
            formModel.IsPriority
        );
    }

    public class FormModel
    {
        public string Name { get; set; } = "";
        public string StudentId { get; set; } = "";
        public string Department { get; set; } = "";
        public string Service { get; set; } = "";
        public bool IsPriority { get; set; } = false;
    }
}