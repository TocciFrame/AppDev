@inherits LayoutComponentBase

<div class="min-h-screen bg-gray-50 flex flex-col font-sans text-gray-900">
    <header class="bg-cit-gold text-white px-6 py-3 flex justify-between items-center shadow-md sticky top-0 z-50">
        <div class="flex items-center gap-3">
            <div class="w-10 h-10 bg-white rounded-full flex items-center justify-center text-xl shadow-inner select-none">
                🎓
            </div>
            <div>
                <span class="block text-lg font-black tracking-tight leading-none">QueueLess</span>
                <span class="text-xs font-semibold tracking-widest text-amber-100 opacity-90">CIT-U</span>
            </div>
        </div>

        <nav class="flex items-center gap-1 sm:gap-2">
            <NavLink href="" Match="NavLinkMatch.All" class="nav-btn text-white px-3.5 py-1.5 rounded-full text-sm font-semibold hover:bg-white/15 transition duration-150">Home</NavLink>
            <NavLink href="student" class="nav-btn text-white px-3.5 py-1.5 rounded-full text-sm font-semibold hover:bg-white/15 transition duration-150">Get Ticket</NavLink>
            <NavLink href="staff" class="nav-btn text-white px-3.5 py-1.5 rounded-full text-sm font-semibold hover:bg-white/15 transition duration-150">Staff</NavLink>
            <NavLink href="dashboard" class="nav-btn text-white px-3.5 py-1.5 rounded-full text-sm font-semibold hover:bg-white/15 transition duration-150">Dashboard</NavLink>
        </nav>
    </header>

    <main class="flex-1">
        @Body
    </main>
</div>